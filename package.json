{
  "name": "rhypdf-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rhypdf/editor dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=msedge",
    "test:e2e:all": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.preview.config.ts --project=msedge",
    "test:e2e:prod:all": "playwright test --config playwright.preview.config.ts",
    "license:check": "node scripts/license_check.mjs",
    "size:check": "node scripts/check_bundle_size.mjs",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@rollup/wasm-node": "^4.68.2",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "15.11.7",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "1.70.0",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  }
}
