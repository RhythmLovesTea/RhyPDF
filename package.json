{
  "name": "rhypdf-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rhypdf/editor dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "lucide-react": "^1.70.0",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
