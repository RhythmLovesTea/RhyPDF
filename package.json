{
  "name": "rhypdf-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rhypdf/editor dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.preview.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
